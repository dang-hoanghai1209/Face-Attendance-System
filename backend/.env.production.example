APP_ENV=production
DATABASE_URL=postgresql://face_attendance_user:change_me@postgres:5432/face_attendance
SECRET_KEY=change_me_generate_with_openssl_rand_hex_32
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=https://your-frontend.example.com

AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=change_me_min_12_chars
AUTH_BOOTSTRAP_ADMIN_NAME=Administrator

THRESHOLD_CONFIRM=0.75
THRESHOLD_UNCERTAIN=0.60
ENABLE_LIVENESS=true
LIVENESS_THRESHOLD=0.45
ENABLE_LEGACY_EMBEDDINGS=false
APP_TIMEZONE=Asia/Nha_Trang

WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=120
