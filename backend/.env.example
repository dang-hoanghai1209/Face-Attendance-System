DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/face_attendance
SECRET_KEY=change_this_to_a_long_random_secret
JWT_EXPIRE_MINUTES=480
APP_ENV=development
POSTGRES_DB=face_attendance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_postgres_password
AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=change_this_admin_password
AUTH_BOOTSTRAP_ADMIN_NAME=Administrator
THRESHOLD_CONFIRM=0.75
THRESHOLD_UNCERTAIN=0.60
ENABLE_LIVENESS=true
LIVENESS_THRESHOLD=0.45
ENABLE_LEGACY_EMBEDDINGS=false
APP_TIMEZONE=Asia/Nha_Trang
