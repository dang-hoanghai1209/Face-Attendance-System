THRESHOLD_CONFIRM=0.75
THRESHOLD_UNCERTAIN=0.60
ENABLE_LIVENESS=true
LIVENESS_THRESHOLD=0.45
ENABLE_LEGACY_EMBEDDINGS=false
APP_TIMEZONE=Asia/Nha_Trang
